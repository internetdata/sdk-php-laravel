{
    "name": "internetdata/laravel",
    "description": "Official Laravel middleware for the InternetData API. Look up the visitor behind every request: location, network, VPN, proxy, Tor and hosting.",
    "keywords": ["laravel", "middleware", "internetdata", "ip-geolocation", "ip-intelligence", "ip-lookup", "geoblocking", "vpn-detection", "proxy-detection", "tor", "hosting", "asn"],
    "homepage": "https://internetdata.io",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "internetdata/internetdata": "^2.13.3",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": { "psr-4": { "InternetData\\Laravel\\": "src/" } },
    "autoload-dev": { "psr-4": { "InternetData\\Laravel\\Tests\\": "tests/" } },
    "extra": {
        "laravel": {
            "providers": ["InternetData\\Laravel\\InternetDataServiceProvider"]
        }
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
